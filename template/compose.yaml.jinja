services:
  web:
    build:
      context: .
      dockerfile: docker/Dockerfile.dev
    ports:
      - "5050:5050"
    env_file:
      - .flaskenv
    environment:
      DATABASE_URL: "postgresql://postgres:password@db/{{ application_name }}"
      TEST_DATABASE_URL: "postgresql://postgres:password@test_db/{{ application_name }}_test"
    volumes:
      - .:/app
      - /app/.venv
    networks:
      - local-network
    depends_on:
      - db

  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: {{ application_name }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - local-network

  test_db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: {{ application_name }}_test
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
    networks:
      - local-network

volumes:
  postgres_data:

networks:
  local-network:
    driver: bridge
